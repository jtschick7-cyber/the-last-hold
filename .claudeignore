# Build output — the bundled/minified game is worse than useless in context
dist/
dist-preview/
dev-dist/
.vite/

# Dependencies and caches
node_modules/
*.tsbuildinfo
.eslintcache

# Test artifacts
coverage/
test-results/
playwright-report/

# Simulator raw output: JSON is huge; .md summaries stay readable
sim/reports/*.json

# Simulator shard results (regenerated, uploaded as CI artifacts)
sim/shards/

# Art sources: ignore the binary files, keep text (License.txt, readmes) readable
art-src/*.zip
art-src/packs/**/*.png
art-src/packs/**/*.gif
art-src/packs/**/*.jpg

*.log
