{
  "name": "the-last-hold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test --project=phone-chromium --project=webkit",
    "bench": "playwright test --project=bench",
    "sim": "vite-node sim/cli.ts --",
    "sim:vigil": "vite-node sim/vigil-curve-cli.ts",
    "sim:check": "vite-node sim/cli.ts -- --check",
    "sim:accept": "vite-node sim/cli.ts -- --check --accept",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-node": "6.0.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
